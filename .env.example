# Copy this file to .env (same folder) and fill in your key. .env is git-ignored: never commit it.
# img2schem reads .env from the folder you run it in, then from the config folder
# (%APPDATA%\img2schem\.env on Windows). A variable already set in your environment wins.
ANTHROPIC_API_KEY=
# Only if your key is not scoped to a workspace (the API then asks for anthropic-workspace-id):
# the workspace ID from console.anthropic.com -> Settings -> Workspaces (starts with wrkspc_).
ANTHROPIC_WORKSPACE_ID=
